---
import FilmLayout from '@/layouts/FilmLayout.astro';
import FilmFooter from '@/components/film/FilmFooter.astro';
import { BrandMark } from '@/components/ui/BrandMark';
import { ArrowIcon } from '@/components/ui/ArrowIcon';
import { caseCategories, caseHref, cases, finalCta } from '@/data/landing';

const pathname = Astro.url.pathname;
---

<FilmLayout
  title="Кейсы — Deep"
  description="Проекты Deep: HR и внутриком, лояльность, мероприятия, спецпроекты и трейд-маркетинг."
>
  <main class="cases-page">
    <header class="cases-page__bar">
      <a class="cases-page__brand" href="/" aria-label="Deep — на главную">
        <BrandMark />
      </a>
      <a class="plate-btn plate-btn--sm" href="/" data-open-contact>
        <span>{finalCta.primary}</span>
        <ArrowIcon direction="right" />
      </a>
    </header>
    <section class="cases-page__intro" aria-labelledby="cases-title">
      <a class="cases-page__back" href="/">
        <ArrowIcon direction="left" />
        <span>На главную</span>
      </a>
      <h1 class="cases-page__title" id="cases-title">
        Все кейсы
      </h1>
      <p class="cases-page__lead">
        Примеры проектов на платформенной базе Deep. Механика, сценарий и
        интеграции каждый раз собираются под задачу клиента.
      </p>
    </section>
    <section class="cases-page__grid" aria-label="Список кейсов">
      {cases.map((item) => {
        const category =
          caseCategories.find((entry) => entry.id === item.categoryId)?.title ??
          item.categoryId;
        return (
          <article class="cases-card" data-brand={item.theme}>
            <div class="cases-card__art" aria-hidden="true">
              <img
                src={item.cover}
                alt=""
                width="1536"
                height="1024"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="cases-card__body">
              <p class="cases-card__kind">{category}</p>
              <h2 class="cases-card__name">
                <a class="cases-card__link" href={caseHref(item.id)}>
                  {item.brand}
                  {item.brandNote && ' '}
                  {item.brandNote && (
                    <small class="cases-card__note">({item.brandNote})</small>
                  )}
                  {' — '}
                  {item.title}
                </a>
              </h2>
              <p class="cases-card__text">{item.description}</p>
              <ul class="cases-card__tags" role="list">
                {item.mechanics.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <span class="cases-card__more" aria-hidden="true">
                Смотреть кейс
                <ArrowIcon direction="right" />
              </span>
            </div>
          </article>
        );
      })}
    </section>
    <section class="cases-page__cta" aria-labelledby="cases-cta-title">
      <h2 id="cases-cta-title">
        {finalCta.title} {finalCta.accent}
      </h2>
      <p>{finalCta.text}</p>
      <a class="plate-btn" href="/" data-open-contact>
        <span>{finalCta.primary}</span>
        <ArrowIcon direction="right" />
      </a>
    </section>
  </main>
  <FilmFooter pathname={pathname} />
</FilmLayout>
