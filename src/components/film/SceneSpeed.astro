---
import { speedWords } from '@/data/film';

const words = speedWords();
---

<section
  class="scene scene--speed"
  data-scene="speed"
  aria-label="Скорость запуска"
>
  <div class="scene__body">
    {words.value !== null && words.from && words.unit ? (
      <div class="speed__row" aria-hidden="true">
        <span class="speed__word speed__word--from">{words.from}</span>
        <span class="speed__ring">
          <svg viewBox="0 0 200 200">
            <circle
              class="speed__track"
              cx="100"
              cy="100"
              r="92"
              pathLength="100"
            />
            <circle
              class="speed__bar"
              cx="100"
              cy="100"
              r="92"
              pathLength="100"
            />
          </svg>
          <span class="speed__digit">
            <span class="speed__digits">
              <i>0</i>
              <i>{words.value}</i>
            </span>
          </span>
        </span>
        <span class="speed__word speed__word--unit">{words.unit}</span>
      </div>
    ) : null}
    <p class="speed__text">{words.sentence}</p>
  </div>
</section>
