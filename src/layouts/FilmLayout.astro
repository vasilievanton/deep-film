---
import '@/styles/film/index.css';
import ContactDialog from '@/components/ui/ContactDialog';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = 'ru' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
    {[
      'montserrat-cyrillic-wght-normal',
      'montserrat-latin-wght-normal',
      'inter-cyrillic-wght-normal',
      'inter-latin-wght-normal',
    ].map((font) => (
      <link
        rel="preload"
        href={`/fonts/${font}.woff2`}
        as="font"
        type="font/woff2"
        crossorigin
      />
    ))}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Режим «фильм» включается до первой отрисовки, на любом экране, если нет просьбы «уменьшить движение».
         Иначе (или без JavaScript, или если движок не запустился) сцены идут обычной колонкой. Какая раскладка
         — широкая или узкая (телефон), решает CSS по соотношению сторон окна. -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!calm) {
          html.classList.add('motion-ok', 'film-live');
          setTimeout(function () {
            if (!html.classList.contains('film-ready')) {
              html.classList.remove('film-live');
            }
          }, 8000);
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <ContactDialog client:load />
  </body>
</html>
